{
  "name": "customer-storage-backend",
  "version": "1.0.0",
  "description": "Customer Storage Backend - NestJS Migration",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.{ts,cjs}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.{ts,cjs}\"",
    "test": "npm run test:security",
    "test:security": "node -r ts-node/register/transpile-only --test test/*.test.cjs",
    "test:watch": "node -r ts-node/register/transpile-only --test --watch test/*.test.cjs",
    "test:cov": "node --experimental-test-coverage -r ts-node/register/transpile-only --test test/*.test.cjs",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register --test test/*.test.cjs",
    "test:e2e": "bash ../scripts/e2e-test.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.{ts,cjs}\" --fix",
    "test:unit": "npm run test:security",
    "test:e2e:runner": "node --test test/e2e/*.e2e.test.cjs",
    "test:all": "npm run lint && npm run build && npm run test:security && npm run test:e2e"
  },
  "keywords": [
    "nestjs",
    "customer-storage",
    "backend"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.9",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@types/qrcode": "^1.5.6",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "docxtemplater": "^3.55.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "mime-types": "^2.1.35",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pizzip": "^3.1.7",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.7",
    "ssh2-sftp-client": "^12.0.1",
    "swagger-ui-express": "^5.0.1",
    "systeminformation": "^5.27.14",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "^2.4.0"
    },
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.9",
    "@types/archiver": "^7.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.8",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
