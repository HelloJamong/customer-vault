# ==========================================
# 고객창고 (Customer-Storage) 환경 변수 설정
# ==========================================
# 사용법:
#   1. 이 파일을 복사: cp .env.example .env
#   2. 환경에 맞게 값 수정
#   3. Docker Compose 실행: docker compose up -d

# ==========================================
# 애플리케이션 환경
# ==========================================
NODE_ENV=development           # development | production
LOG_LEVEL=info                 # debug | info | warn | error

# ==========================================
# 애플리케이션 버전
# ==========================================
# Docker 이미지 버전 (선택사항)
# 기본값: latest (항상 최신 버전 사용)
# 특정 버전 고정이 필요한 경우에만 설정하세요.
# 예: VERSION=2.1.6
# VERSION=latest

# ==========================================
# 데이터베이스 설정 (MariaDB)
# ==========================================
DB_ROOT_PASSWORD=
DB_NAME=customer_db
DB_USER=customer_user
DB_PASSWORD=
DB_PORT=3306

# 최초 설치 시 빈 DB에 생성할 admin 계정의 초기 비밀번호입니다.
# 기존 DB가 있는 경우에는 변경하지 않아도 됩니다. 값이 없으면 빈 DB로 시작할 수 없습니다.
INITIAL_ADMIN_PASSWORD=

# ==========================================
# JWT 인증 설정
# ==========================================
# ⚠️ 반드시 아래 명령으로 생성한 값으로 채우세요. 비워두거나 예시값이면 서버가 기동을 거부합니다.
# 생성: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_ACCESS_EXPIRATION=1h       # 개발: 1h, 프로덕션: 15m 권장
JWT_REFRESH_EXPIRATION=7d

# ==========================================
# 백엔드 API 설정
# ==========================================
# 백엔드는 Docker 내부 네트워크에서만 5000번 포트로 동작합니다.
# 외부 접속은 PROXY_PORT를 사용하세요. BACKEND_PORT는 더 이상 사용하지 않습니다.
MAX_UPLOAD_SIZE=16777216       # 16MB (바이트 단위)
CLAMAV_ENABLED=true             # 악성코드 검사 활성화 (운영 환경에서 끄지 마세요)
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_SCAN_TIMEOUT_MS=30000
CORS_ORIGIN=*                  # 개발: *, 프로덕션: https://yourdomain.com
UPLOAD_DIR=./uploads           # 파일 업로드 디렉토리

# ==========================================
# 애플리케이션 암호화 키 (SFTP 패스워드 및 서버 접속정보용)
# ==========================================
# 32바이트(64자 hex) 랜덤 문자열. 비워두거나 전부 0이면 서버가 기동을 거부합니다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# 백업 파일 암호화 키 (ENCRYPTION_KEY와 반드시 다른 값을 사용)
# DB/문서 백업은 AES-256-GCM으로 암호화되며, 키가 없으면 서버가 기동하지 않습니다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKUP_ENCRYPTION_KEY=

# ==========================================
# 프론트엔드 설정
# ==========================================
VITE_PORT=3003
PROXY_PORT=2082
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_ENV=development
VITE_ACCESS_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token

# ==========================================
# 프로덕션 환경 예시
# ==========================================
# NODE_ENV=production
# LOG_LEVEL=warn
# JWT_SECRET=생성된_랜덤_문자열_128자
# JWT_ACCESS_EXPIRATION=15m
# DB_ROOT_PASSWORD=강력한_루트_비밀번호
# DB_PASSWORD=강력한_DB_비밀번호
# CORS_ORIGIN=https://yourdomain.com,https://app.yourdomain.com

# ==========================================
# ⚠️ 주의사항
# ==========================================
# 1. .env 파일은 절대 Git에 커밋하지 마세요!
# 2. 프로덕션에서는 모든 비밀번호를 강력한 랜덤 값으로 설정하세요
# 3. JWT_SECRET은 128자 이상의 랜덤 문자열로 설정하세요
